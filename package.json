{
  "name": "m0on-converter",
  "version": "1.0.0",
  "description": "M0ON Converter — конвертер голосовых команд из XML в JSON",
  "author": "m0onmag",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.m0on.converter",
    "productName": "M0ON Converter",
    "compression": "maximum",
    "electronLanguages": ["ru", "en-US"],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "converter.js",
      "convert-worker.js",
      "m0on_industries.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "m0on_industries.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1049"
    }
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  }
}
